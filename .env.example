# 3DDD Studio environment configuration
# Copy to .env.local and fill in values. NEVER commit real tokens.

# Fine-grained GitHub PAT with "Contents: read & write" permission on
# sudo-prog/3ddd-studio. Used by src/githubStorage.ts to persist uploaded
# custom models to public/models/ in the repo (default storage path).
# If unset, uploads fall back to browser-local IndexedDB only.
VITE_GITHUB_TOKEN=

# Branch that uploaded models are committed to (default: main)
VITE_GITHUB_BRANCH=main
